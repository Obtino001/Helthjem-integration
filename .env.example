# ==============================================================================
# Server & Environment Configuration
# ==============================================================================
PORT=3000
NODE_ENV=development

# ==============================================================================
# Helthjem API Configuration
# Pre-prod Base URL: https://api.pre.helthjem.no
# Pre-prod Shop ID:  16
# Production Shop ID: 2439
# Note: Base URL and credentials must be supplied via environment, never hardcoded.
# ==============================================================================
HELTHJEM_BASE_URL=https://api.pre.helthjem.no
HELTHJEM_SHOP_ID=16
HELTHJEM_CLIENT_ID=your_helthjem_client_id_here
HELTHJEM_CLIENT_SECRET=your_helthjem_client_secret_here
HELTHJEM_TRANSPORT_SOLUTION_ID=2

# Helthjem Shipping Rate Returned to Shopify
HELTHJEM_RATE_NAME=Helthjem - Hjemlevering | 1-3 virkedager
HELTHJEM_RATE_CODE=helthjem_home
HELTHJEM_RATE_DESCRIPTION=Helthjem standard home delivery
HELTHJEM_RATE_PRICE=7900
HELTHJEM_RATE_CURRENCY=NOK

# Request Timeout (milliseconds)
HELTHJEM_TIMEOUT_MS=4000

# ==============================================================================
# Manual Coverage Test Endpoint (/api/helthjem/coverage)
# ==============================================================================
ENABLE_TEST_ENDPOINT=true
TEST_API_KEY=your_secret_test_key_for_manual_endpoint

# ==============================================================================
# Shopify Integration & Registration
# Used by scripts/list-carriers.js and scripts/register-carrier.js
# ==============================================================================
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-07
PUBLIC_BASE_URL=https://your-service.onrender.com
SHOPIFY_CARRIER_NAME=Helthjem Coverage
